# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). The anon key is safe to expose in the browser;
# access is enforced by the row-level security policies in supabase/migrations.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
